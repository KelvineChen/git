# FastAPI backend URL used by Streamlit clients
BACKEND_URL=http://localhost:8000

# Leave unset locally to use backend/app.db. Set this on Render.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database

# AI provider settings
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Initial administrator setup
INITIAL_ADMIN_PASSWORD=replace-with-an-admin-password
INITIAL_ADMIN_USER_PASSWORD=replace-with-a-user-password

# Email verification (Resend HTTPS API)
EMAIL_VERIFICATION_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-email-provider-key
EMAIL_FROM=知遇 LinkLab <verify@your-domain.example>
EMAIL_CODE_PEPPER=replace-with-a-long-random-secret
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_SEND_INTERVAL_SECONDS=60
EMAIL_DAILY_LIMIT=10
EMAIL_MAX_ATTEMPTS=5
